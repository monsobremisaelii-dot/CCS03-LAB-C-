#include <stdio.h>

int main()
{
    float Length, Width, Area;


    //Input
    printf("Enter Length of Rectangle: ");
    scanf("%f",&Length);

    printf("Enter Width of Rectangle: ");
    scanf("%f",&Width);

    //Process
    Area = Length * Width;
    
    //Output
    printf("Area = %.2f",Area);

    return 0;

    
}
