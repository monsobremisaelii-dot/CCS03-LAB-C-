#include <stdio.h>

int main() {

    int Number,Remainder;
    
    //Input
    printf("Enter a Number: ");
    scanf("%i",&Number);

    // Process and Output

    Remainder = Number % 2;

    
    if (Remainder == 0)
        
    {
        printf("The Number is Even. \n");
    }
    
    else 

    {
        printf("The Number is Odd. \n");
    }

    return 0;
}
