#include <stdio.h>

int main()
{
    
    float Base, Height, Area;
    
    //Input
    
    printf("Enter Base of triangle: ");
    scanf("%f",&Base);
    
    printf("Enter Height of triangle: ");
    scanf("%f",&Height);
    
    //Process
    
    Area = (Base * Height)/2;
    
    //Output
    
    printf("Area = %.2f",Area);

    return 0;
}
