#include <stdio.h>

int main()
{
    
    float Radius, Pi, Area;
    
    // input
    
    printf("Enter Radius: ");
    
    scanf("%f",&Radius);
    
    // process
    
    Pi = 3.14159265359;
    
    Area = Pi * (Radius * Radius);
    
    // output
    
    printf("Area = %.2f", Area);
    

    return 0;
}
